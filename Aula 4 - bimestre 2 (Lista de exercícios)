//Código da aula de hoje:
#include <stdio.h>
#include <stdlib.h>

/* Lista de Exercicíos  */

int main(int argc, char *argv[]) {	
	//EXERCÍCIO 1;
	/*Elabore um programa que permita a entrada de três valores.
	E controle do primeiro valor inserido até o segundo valor, com 
	o passo da contagem dado pelo terceiro valor */
	//ex: 1, 8, 2 >> contar de 1 a 8, com passo 2 = 3, 5, 7.
	int v1, v2, v3;

    printf("Entre com o valor inicial, final e passo: ");
    scanf("%d %d %d", &v1, &v2, &v3);

    if (v3 <= 0) {
        printf("O passo deve ser maior que zero!");
    }
    else if (v1 < v2) {
        while (v1 <= v2) {
            printf("|%d|", v1);
            v1 += v3;
        }
    }
    else if (v1 > v2) {
        while (v1 > v2) {
            printf("|%d|", v1);
            v1 -= v3;
        }
    }
    else {
        printf("|%d|", v1);
    }

	//EXERCÍCIO 2;
	/*Faça um programa que receba 1 número n e realize a soma dos
	n primeiros termos da sequência definida [S = 1/2; 1/4; 1/8; 1/16...N]*/
	
	
	
	
	
	
	//EXERCÍCIO 3;
	/*Crie um programa que exiba na tela, o triângulo de pascal.*/
	int n, linha = 0, coluna, numero;
    printf("Digite a quantidade de linhas: ");
    scanf("%d", &n);

    while (linha < n) {

        coluna = 0;
        numero = 1;

        while (coluna <= linha) {
            printf("%d ", numero);

            numero = numero * (linha - coluna) / (coluna + 1);

            coluna++;
        }

        printf("\n");
        linha++;
    }
	
	return 0;
}

