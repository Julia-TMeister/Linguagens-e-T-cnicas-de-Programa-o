//Exercicio 2
void exercicioEsoftA2() {

    float valor;
    float resultado;
    int codigo;

    printf("EXERCICIO 2 \n");

    printf("Digite o valor a ser convertido: ");
    scanf("%f", &valor);

    printf("Escolha a unidade de conversao:\n");

    printf("1  - Celsius para Fahrenheit\n");
    printf("2  - Fahrenheit para Celsius\n");
    printf("3  - Celsius para Kelvin\n");
    printf("4  - Kelvin para Celsius\n");
    printf("5  - Metro para Milha\n");
    printf("6  - Milha para Metro\n");
    printf("8  - Quilograma para Libra\n");
    printf("9  - Libra para Quilograma\n");
    printf("10 - Km/h para Mph\n");
    printf("11 - Mph para Km/h\n");

    printf("Digite o numero da sua escolha: ");
    scanf("%d", &codigo);

    switch (codigo) {

        case 1:
            resultado = valor * 1.8 + 32;
            printf("Resultado: %.2f Fahrenheit\n", resultado);
            break;


        case 2:
            resultado = (valor - 32) / 1.8;
            printf("Resultado: %.2f Celsius\n", resultado);
            break;


        case 3:
            resultado = valor + 273.15;
            printf("Resultado: %.2f Kelvin\n", resultado);
            break;


        case 4:
            resultado = valor - 273.15;
            printf("Resultado: %.2f Celsius\n", resultado);
            break;


        case 5:
            resultado = valor / 1609.34;
            printf("Resultado: %.6f milhas\n", resultado);
            break;


        case 6:
            resultado = valor * 1609.34;
            printf("Resultado: %.2f metros\n", resultado);
            break;


        case 8:
            resultado = valor * 2.205;
            printf("Resultado: %.2f libras\n", resultado);
            break;


        case 9:
            resultado = valor / 2.205;
            printf("Resultado: %.2f quilogramas\n", resultado);
            break;


        case 10:
            resultado = valor / 1.609;
            printf("Resultado: %.2f mph\n", resultado);
            break;


        case 11:
            resultado = valor * 1.609;
            printf("Resultado: %.2f km/h\n", resultado);
            break;


        default:
            printf("Unidade de medida nao existe no sistema.\n");
    }
}

